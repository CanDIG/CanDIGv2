# CanDIGv2 Global Environment Variables
# - - -

# =============================================================================
# DEVELOPMENT CONFIGURATION
# Variables in this section are unlikely to need to be changed.
# Please consult with a CanDIG developer before changing if you aren't
# familiar with what the variable does.
# =============================================================================

CANDIG_DOMAIN=candig.docker.internal
CANDIG_INTERNAL_DOMAIN=${CANDIG_DOMAIN}
CANDIG_AUTH_DOMAIN=candig.docker.internal
CANDIG_SITE_LOCATION=local
CANDIG_DEBUG_MODE=1
LOCAL_IP_ADDR=
# miniforge venv
# options are [linux, darwin, arm64mac]
VENV_OS=linux
# this is the unique key used by your site IDP to identify users.
CANDIG_USER_KEY=preferred_username
# Set KEEP_TEST_DATA to true to have the integration tests keep all test data
KEEP_TEST_DATA=false

# Backup
BACKUP_LOCATION=tmp/backups

# Federation
FEDERATION_PORT=4232
FEDERATION_SERVICE_URL=http://${CANDIG_INTERNAL_DOMAIN}:${FEDERATION_PORT}
FEDERATION_SELF_SERVER_ID=internal-1
FEDERATION_SELF_SERVER="{'id': '${FEDERATION_SELF_SERVER_ID}', 'url': '${FEDERATION_SERVICE_URL}','location': {'name': '${CANDIG_SITE_LOCATION}','province': 'ON','province-code': 'ca-on'}}"

# Keycloak
KEYCLOAK_PRODUCTION_MODE=0
KEYCLOAK_CLIENT_ID=local_candig
KEYCLOAK_PORT=8080
KEYCLOAK_HTTPS_PORT=8443
KEYCLOAK_PUBLIC_PROTO=http
KEYCLOAK_PRIVATE_PROTO=http
KEYCLOAK_PUBLIC_URL=${KEYCLOAK_PUBLIC_PROTO}://${CANDIG_AUTH_DOMAIN}:${KEYCLOAK_PORT}
KEYCLOAK_PRIVATE_URL=${KEYCLOAK_PRIVATE_PROTO}://${CANDIG_AUTH_DOMAIN}:${KEYCLOAK_PORT}
KEYCLOAK_PROXY_HEADERS=none

# Tyk gateway
TYK_LOGIN_TARGET_URL=http://${CANDIG_DOMAIN}:${TYK_SERVICE_PUBLIC_PORT}
TYK_ANALYTICS_FROM_EMAIL=admin@distributedgenomics.ca
TYK_USE_SSL=false

# Data portal
CANDIG_DATA_PORTAL_PORT=4173
CANDIG_DATA_PORTAL_URL=https://${CANDIG_DOMAIN}:${CANDIG_DATA_PORTAL_PORT}/data-portal
CANDIG_DATA_PORTAL_SUPPORT_EMAIL=site_admin@test.ca
MOHCCN_SUPPORT_EMAIL=mohdatarequests@tfri.ca

# =============================================================================
# END DEVELOPMENT CONFIGURATION
# =============================================================================

# site options
CANDIG_MODULES=logging keycloak vault redis postgres drs htsget katsu rnaget query tyk opa candig-ingest federation candig-data-portal
CANDIG_AUTH_MODULES=keycloak vault tyk opa federation
CANDIG_DATA_MODULES=keycloak vault redis postgres logging

# default name for built-in site admin
DEFAULT_SITE_ADMIN_USER=site_admin@${CANDIG_SITE_LOCATION}-test.ca
# Note: change to the preferred_username of your client for client auth grant

# default name for admin accounts
DEFAULT_ADMIN_USER=admin

# default names for test users
TEST_USER_1=user1@${CANDIG_SITE_LOCATION}-test.ca
TEST_USER_2=user2@${CANDIG_SITE_LOCATION}-test.ca

VENV_NAME=candig

# docker
DOCKER_NAMESPACE=candig
DOCKER_REGISTRY=candig

# WARNING: Do not change this value unless indicated by MOHCCN policy
AGGREGATE_COUNT_THRESHOLD=10

# logging services
#TODO: test monitoring version updates
FLUENTD_PORT=24224
ELASTIC_SEARCH_HTTP_PORT=9200
ELASTIC_SEARCH_TRANSPORT=9300
KIBANA_PORT=5601

# monitoring services
PROMETHEUS_PORT=9090
NODE_EXPORTER_PORT=9100
ALERT_MANAGER_PORT=9093
CADVISOR_PORT=9080
GRAFANA_PORT=9888


# minio server
MINIO_UI_PORT=9001
MINIO_PORT=9000
MINIO_PUBLIC_URL=http://${CANDIG_INTERNAL_DOMAIN}:${MINIO_PORT}
MINIO_PRIVATE_URL=http://minio:9000
MINIO_BUCKET=samples
MINIO_REGION=us-east-1
MINIO_DATA_DIR=/data

# set to 1 if using SSL via self-signed certificate
MINIO_SELF_CERT=0

# docker volume options for minio-data
#MINIO_VOLUME_OPT=--driver=local
#MINIO_VOLUME_OPT+=--opt=type=ext4
#MINIO_VOLUME_OPT+=--opt=device=/dev/sdb1


# htsget
HTSGET_PRIVATE_URL=http://htsget:3000/${TYK_HTSGET_API_LISTEN_PATH}
HTSGET_PUBLIC_URL=${TYK_LOGIN_TARGET_URL}/${TYK_HTSGET_API_LISTEN_PATH}
HTSGET_PORT=3333


# drs
DRS_PRIVATE_URL=http://drs:3001/${TYK_DRS_API_LISTEN_PATH}
DRS_PUBLIC_URL=${TYK_LOGIN_TARGET_URL}/${TYK_DRS_API_LISTEN_PATH}
DRS_PORT=3001


# federation
FEDERATION_IP=0.0.0.0
FEDERATION_PORT=4232
FEDERATION_SERVICE_URL=http://${CANDIG_INTERNAL_DOMAIN}:${FEDERATION_PORT}
FEDERATION_PUBLIC_URL=${TYK_LOGIN_TARGET_URL}/${TYK_FEDERATION_API_LISTEN_PATH}
FEDERATION_PRIVATE_URL=http://federation:${FEDERATION_PORT}/${TYK_FEDERATION_API_LISTEN_PATH}
FEDERATION_SERVICES=katsu htsget query drs


# katsu metadata service
KATSU_PORT=8008
KATSU_PUBLIC_URL=${TYK_LOGIN_TARGET_URL}/${TYK_KATSU_API_LISTEN_PATH}
KATSU_INGEST_URL=http://${CANDIG_INTERNAL_DOMAIN}:${KATSU_PORT}
KATSU_PRIVATE_URL=http://katsu:8000
KATSU_ALLOWED_HOSTS=${CANDIG_INTERNAL_DOMAIN},${CANDIG_DOMAIN},katsu,query
KATSU_CACHE_DURATION=86400
KATSU_WORKERS=2
KATSU_THREADS=4


# keycloak service
KEYCLOAK_REALM=candig
KEYCLOAK_LOGIN_REDIRECT_PATH=/auth/login
KEYCLOAK_AUTH_PREFIX=/auth
KEYCLOAK_REALM_URL=${KEYCLOAK_PUBLIC_URL}${KEYCLOAK_AUTH_PREFIX}/realms/${KEYCLOAK_REALM}
KEYCLOAK_ISSUER_URL=${KEYCLOAK_PUBLIC_URL}${KEYCLOAK_AUTH_PREFIX}/realms/${KEYCLOAK_REALM}
KEYCLOAK_GENERATE_TEST_USER=1


# query service
QUERY_PORT=1236
QUERY_PRIVATE_URL=http://query:3000/${TYK_QUERY_API_LISTEN_PATH}
QUERY_INTERNAL_URL=http://${CANDIG_INTERNAL_DOMAIN}:${QUERY_PORT}/${TYK_QUERY_API_LISTEN_PATH}

# ingest service
CANDIG_INGEST_PORT=1235
CANDIG_INGEST_PRIVATE_URL=http://candig-ingest:${CANDIG_INGEST_PORT}/${TYK_INGEST_API_LISTEN_PATH}
CANDIG_INGEST_PUBLIC_URL=${TYK_LOGIN_TARGET_URL}/${TYK_INGEST_API_LISTEN_PATH}
# Adjust these two if you need to setup a custom mapping from s3 bucket to ip address
ECS_DOMAIN=your.ecs.domain
ECS_IP_ADDR=127.0.0.1

# rnaget service
RNAGET_PORT=5005
RNAGET_PRIVATE_URL=http://rnaget:5000
RNAGET_INTERNAL_URL=http://${CANDIG_INTERNAL_DOMAIN}:${RNAGET_PORT}

# tyk service
TYK_SERVICE_PUBLIC_PORT=5080
TYK_SERVICE_HOST=0.0.0.0
#TODO: consolidate tyk public and private domains
TYK_PRIVATE_URL=http://${CANDIG_DOMAIN}:${TYK_SERVICE_PUBLIC_PORT}
TYK_ANALYTICS_FROM_NAME=CanDIG Admin
TYK_LISTEN_PATH=
TYK_POLICY_ID=candig_policy

## api - authentication
TYK_AUTH_API_ID=11
TYK_AUTH_API_SLUG=authentication

## api - katsu
TYK_KATSU_API_ID=31
TYK_KATSU_API_SLUG=katsu
TYK_KATSU_API_TARGET=${KATSU_PRIVATE_URL}
TYK_KATSU_API_LISTEN_PATH=katsu

## api - mcode - candig-data-portal
TYK_CANDIG_DATA_PORTAL_API_ID=41
TYK_CANDIG_DATA_PORTAL_API_SLUG=candig-data-portal
TYK_CANDIG_DATA_PORTAL_API_TARGET=${CANDIG_DATA_PORTAL_PRIVATE_URL}
TYK_CANDIG_DATA_PORTAL_API_LISTEN_PATH=

## api - graphql
# TYK_GRAPHQL_API_ID=51
# TYK_GRAPHQL_API_SLUG=graphql-interface
# TYK_GRAPHQL_API_TARGET=${GRAPHQL_PRIVATE_URL}
# TYK_GRAPHQL_API_LISTEN_PATH=graphql

## api - htsget
TYK_HTSGET_API_ID=61
TYK_HTSGET_API_SLUG=htsget
TYK_HTSGET_API_TARGET=${HTSGET_PRIVATE_URL}
TYK_HTSGET_API_LISTEN_PATH=genomics

## api - opa
TYK_OPA_API_ID=71
TYK_OPA_API_SLUG=opa
TYK_OPA_API_TARGET=${OPA_PRIVATE_URL}
TYK_OPA_API_LISTEN_PATH=policy

## api - vault
TYK_VAULT_API_ID=81
TYK_VAULT_API_SLUG=vault
TYK_VAULT_API_TARGET=${VAULT_PRIVATE_URL}
TYK_VAULT_API_LISTEN_PATH=vault

## api - federation
TYK_FEDERATION_API_ID=91
TYK_FEDERATION_API_SLUG=federation
TYK_FEDERATION_API_TARGET=${FEDERATION_PRIVATE_URL}
TYK_FEDERATION_API_LISTEN_PATH=federation

## api - ingest
TYK_INGEST_API_ID=101
TYK_INGEST_API_SLUG=ingest
TYK_INGEST_API_TARGET=${CANDIG_INGEST_PRIVATE_URL}
TYK_INGEST_API_LISTEN_PATH=ingest

## api - query
TYK_QUERY_API_ID=102
TYK_QUERY_API_SLUG=query
TYK_QUERY_API_TARGET=${QUERY_PRIVATE_URL}
TYK_QUERY_API_LISTEN_PATH=query

## api - rnaget
TYK_RNAGET_API_ID=111
TYK_RNAGET_API_SLUG=rnaget
TYK_RNAGET_API_TARGET=${RNAGET_PRIVATE_URL}
TYK_RNAGET_API_LISTEN_PATH=rnaget

## api - drs
TYK_DRS_API_ID=112
TYK_DRS_API_SLUG=drs
TYK_DRS_API_TARGET=${DRS_PRIVATE_URL}
TYK_DRS_API_LISTEN_PATH=drs

## Extra APIs can be added here
## api - example
#TYK_EXAMPLE_API_ID=666
#TYK_EXAMPLE_API_SLUG=example
#TYK_EXAMPLE_API_TARGET=http://example.org
#TYK_EXAMPLE_API_LISTEN_PATH=example


# vault service
VAULT_FILE_PATH="/vault/data"
VAULT_TLS_DISABLE=1
VAULT_UI=true
VAULT_SERVICE_PORT=8200
VAULT_SERVICE_HOST=0.0.0.0
#TODO: consolidate vault public and private domains
VAULT_SERVICE_PUBLIC_URL=http://${CANDIG_INTERNAL_DOMAIN}:${VAULT_SERVICE_PORT}
VAULT_PRIVATE_URL=http://vault:8200
## VAULT_JWKS= ###(generated in setup.sh)


# OPA
OPA_PORT=8181
OPA_LOG_LEVEL=debug
OPA_URL=http://${CANDIG_INTERNAL_DOMAIN}:${OPA_PORT}
OPA_PRIVATE_URL=http://opa:8181


# candig-data-portal (previously mcode)
CANDIG_DATA_PORTAL_PRIVATE_URL=http://candig-data-portal:${CANDIG_DATA_PORTAL_PORT}

# vault helper tool
TOKEN_PATH=${PWD}/Vault-Helper-Tool/token.txt
PROGRESS_FILE=${PWD}/tmp/progress.txt

# install logging
LOGFILE=tmp/progress.txt

CONDA_INSTALL=bin/miniforge

COMPOSE_IGNORE_ORPHANS=True

# Alternative to the ROPC chain -- alter only if ROPC needs to be disabled (due to e.g. security concerns)
# Options are ROPC CLIENT AUTH_CODE
OIDC_CHAIN=ROPC
# AUTH_CODE-specific variables (for use in auth_code_acceptor.py):
# NB: The AUTH_ACCEPT_URL might not work in most cases -- please configure your reverse proxy accordingly
AUTH_ACCEPT_PORT=8989
AUTH_ACCEPT_URL=http://${CANDIG_DOMAIN}:${AUTH_ACCEPT_PORT}
# CLIENT-specific variables
KEYCLOAK_SERVICE_CLIENT_ID=site_admin

DIR_PERMISSIONS=775